# 复制为 .env 后按需修改；本文件不含任何秘密，可安全入库
SECRET_KEY=dev-only-change-me
DATABASE_URL=sqlite:///data/app.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 第 6 天起默认 false：真实评测由 judge/judge_daemon.py 承担。
# 若本机 .env 是旧的 true，请删除 backend/.env 后由 start_backend.ps1 重新复制本模板。
# （冒烟 smoke.py 内部会临时设 true，不受本项影响；改后需重启后端生效）
FAKE_JUDGE=false
